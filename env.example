# =============================================================
#  Fitness Buddy — Environment Configuration Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit your actual .env file to version control.
# =============================================================

# ── IBM watsonx.ai Credentials ────────────────────────────────
# IBM Cloud IAM API key
# Get it from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_watsonx_api_key_here

# watsonx.ai Project ID
# Get it from: https://dataplatform.cloud.ibm.com → Your Project → Manage → General
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# watsonx.ai regional endpoint — choose the region closest to you
# us-south : https://us-south.ml.cloud.ibm.com
# eu-de    : https://eu-de.ml.cloud.ibm.com   (Frankfurt)
# jp-tok   : https://jp-tok.ml.cloud.ibm.com
# au-syd   : https://au-syd.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model (Lite-plan compatible)
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ── Flask Configuration ───────────────────────────────────────
# Secret key for Flask session signing — use a long random string
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret-string

# Flask runtime settings
FLASK_DEBUG=False
PORT=5000
